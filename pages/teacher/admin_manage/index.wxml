<view class="manage-page">
  <view class="paper-noise"></view>
  <scroll-view scroll-y class="page-scroll">
    <view class="hero-panel">
      <view class="hero-kicker">管理权限</view>
      <view class="hero-title">管理员申请与邀请</view>
      <view class="hero-desc">教师可以邀请指定微信号成为管理员，也可以审核学生主动提交的申请。</view>
    </view>

    <view class="section-card invite-card">
      <view class="section-head">
        <view>
          <view class="section-title">邀请管理员</view>
          <view class="section-subtitle">填写对方微信号。若对方已登录并提交申请，会自动升级为管理员。</view>
        </view>
      </view>

      <input class="field-input" placeholder="请输入目标微信号" value="{{inviteForm.targetWechatId}}" bindinput="onInviteWechatIdInput" />
      <textarea class="field-textarea" maxlength="120" placeholder="备注邀请用途，例如负责年级、值班范围" value="{{inviteForm.note}}" bindinput="onInviteNoteInput"></textarea>
      <button class="primary-btn" bindtap="createInvitation" disabled="{{creatingInvitation}}">{{creatingInvitation ? '创建中...' : '创建管理员邀请'}}</button>
    </view>

    <view class="tab-row">
      <view class="tab-pill {{currentTab === 'applications' ? 'active' : ''}}" bindtap="switchTab" data-tab="applications">申请列表 · {{applications.length}}</view>
      <view class="tab-pill {{currentTab === 'invitations' ? 'active' : ''}}" bindtap="switchTab" data-tab="invitations">邀请列表 · {{invitations.length}}</view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">{{currentTab === 'applications' ? '管理员申请' : '管理员邀请'}}</view>
          <view class="section-subtitle">{{currentTab === 'applications' ? '优先处理待审核申请。' : '这里会显示所有邀请及其生效状态。'}}</view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="empty-state">加载中...</view>

      <block wx:elif="{{currentTab === 'applications' && applications.length > 0}}">
        <view wx:for="{{applications}}" wx:key="id" class="manage-card">
          <view class="manage-card-top">
            <view class="manage-card-title">{{item.nickName}}</view>
            <view class="status-chip {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="manage-card-meta">微信号：{{item.wechatId}}</view>
          <view class="manage-card-meta">提交时间：{{item.createdAt}}</view>
          <view class="manage-card-desc">申请说明：{{item.reason || '未填写说明'}}</view>
          <view wx:if="{{item.reviewNote}}" class="manage-card-note">审核说明：{{item.reviewNote}}</view>
          <view wx:if="{{item.status === 'pending'}}" class="action-row">
            <button class="secondary-btn" bindtap="reviewApplication" data-id="{{item.id}}" data-action="reject" disabled="{{reviewingId === item.id}}">拒绝</button>
            <button class="primary-btn compact" bindtap="reviewApplication" data-id="{{item.id}}" data-action="approve" disabled="{{reviewingId === item.id}}">{{reviewingId === item.id ? '处理中...' : '通过'}}</button>
          </view>
        </view>
      </block>

      <block wx:elif="{{currentTab === 'invitations' && invitations.length > 0}}">
        <view wx:for="{{invitations}}" wx:key="id" class="manage-card">
          <view class="manage-card-top">
            <view class="manage-card-title">{{item.targetWechatId}}</view>
            <view class="status-chip {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="manage-card-meta">创建时间：{{item.createdAt}}</view>
          <view class="manage-card-meta" wx:if="{{item.createdByName}}">创建人：{{item.createdByName}}</view>
          <view class="manage-card-desc">备注：{{item.note || '无'}}</view>
          <view wx:if="{{item.claimedUserName}}" class="manage-card-note">已生效账号：{{item.claimedUserName}}</view>
          <view wx:if="{{item.processedAt}}" class="manage-card-note">生效时间：{{item.processedAt}}</view>
        </view>
      </block>

      <view wx:else class="empty-state">当前列表暂无内容。</view>
    </view>
  </scroll-view>
</view>